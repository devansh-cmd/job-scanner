# Copy to .env for local runs (never commit .env). Same names as GitHub Secrets.
# Required for emailing:
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx    # Gmail app password (Google Account > Security > App passwords)
DIGEST_TO=you@gmail.com

# Optional sources (skipped when empty):
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Once you have Jev access (then set judge: jev in config/settings.yaml):
JEV_API_KEY=
